    "opacity": { "min": 0.45, "max": 0.95 }
  },
  "motion": {
    "nebulaDriftSeconds": 90,
    "twinkleAmplitude": 0.25
  },
  "blend": {
    "flowerWrapper": "screen",
    "tint": "color"
  }
