rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /activities/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "ISI_UID_ADMIN";
    }
    match /site/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "ISI_UID_ADMIN";
    }
  }
}
